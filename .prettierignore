# Mirrors .gitignore: nothing generated, vendored, or native is ours to format.
# Prettier already skips most of this by default, but `npm run format` runs over the whole
# repo, so anything that appears later (an ejected android/, a build output) is covered here
# rather than being silently rewritten.

node_modules/
coverage/

# Expo output and generated types
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects, regenerated by prebuild
/ios
/android

# Owned by npm
package-lock.json

# Vendored from sukun-backend/openapi. Reformatting would make it stop matching the file it
# was copied from, which is the only way to tell whether it has gone stale.
openapi/
