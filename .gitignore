# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# EAS local credentials (paths + p12 passwords)
credentials.json
/ios
/android

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# testing
coverage/

# Claude Code local tooling (agent config, MCP servers, session settings).
# CLAUDE.md stays tracked — it is project documentation, not tooling state.
.claude/
.mcp.json

# Handover and review write-ups. Notes written for a person about work in flight, not project
# documentation: they go stale the moment the work lands, and they are not the repo's to carry.
*_HANDOFF.md
*_REVIEW.md
