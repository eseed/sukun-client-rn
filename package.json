{
  "name": "sukun-client-rn",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "npm run typecheck && npm run lint && npm test -- --ci",
    "staging:android": "npm run verify && eas build --platform android --profile staging",
    "staging:ios": "npm run verify && eas build --platform ios --profile staging --auto-submit",
    "release:ios": "npm run verify && eas build --platform ios --profile production --auto-submit",
    "release:android": "npm run verify && eas build --platform android --profile production --auto-submit",
    "build:android:local": "node scripts/assert-android-signing.mjs && scripts/gradlew-release.sh",
    "version:ios": "node scripts/ios-build-number.mjs",
    "build:ios:local": "node scripts/assert-ios-signing.mjs && node scripts/ios-build-number.mjs && scripts/xcodebuild-release.sh",
    "publish:ios:local": "node scripts/asc-upload.mjs",
    "release:ios:local": "npm run verify && npm run build:ios:local && npm run publish:ios:local",
    "publish:android:local": "node scripts/play-publish.mjs",
    "play:status": "node scripts/play-status.mjs",
    "release:android:local": "npm run verify && npm run build:android:local && npm run publish:android:local"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@hookform/resolvers": "^5.7.1",
    "@microsoft/react-native-clarity": "^4.7.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.31",
    "expo-application": "~57.0.2",
    "expo-brightness": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-calendar": "~57.0.6",
    "expo-constants": "~57.0.10",
    "expo-contacts": "~57.0.8",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "libphonenumber-js": "^1.13.11",
    "mixpanel-react-native": "^3.6.0",
    "paymob-reactnative": "github:PaymobAccept/paymob-reactnative-sdk#33428ada55806cdaee20dbd7fa4448d9d374d366",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.3",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-kochava-measurement": "5.0.0",
    "react-native-kochava-measurement-google": "5.0.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eas-cli": "^23.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "ajv@8": "8.18.0",
    "joi@17": "17.13.8",
    "minimatch@5": "5.1.8",
    "mixpanel-react-native": {
      "uuid": "11.1.1"
    },
    "nanoid@3": "3.3.18",
    "tar": "7.5.21",
    "uuid@<11.1.1": "11.1.1",
    "xcode": {
      "uuid": "11.1.1"
    },
    "yaml@<2.8.3": "2.8.3"
  }
}
