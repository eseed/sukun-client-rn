# Keep this list aligned with .gitignore; EAS uses .easignore instead of .gitignore.

# dependencies
node_modules/
.git/

# Expo
.expo/
dist/
build/
web-build/
expo-env.d.ts

# Native projects are regenerated by prebuild from the Expo config/plugins.
/android
/ios

# Native credentials and local signing artifacts
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
credentials.json

# EAS ignores local env files and Firebase Admin private service-account keys.
.env
.env.*
!.env.example
*-firebase-adminsdk-*.json

# Local outputs and temporary build snapshots
*.apk
/.apk-build-current/
/.apk-build-latest/
/.latest-eas-build/
/docs/

# Tooling, caches, and test output
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.tsbuildinfo
coverage/
.claude/
.mcp.json
*_HANDOFF.md
*_REVIEW.md
