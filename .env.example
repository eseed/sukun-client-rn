# Which api backend the app talks to: "mock" (default, no server needed) or "live".
EXPO_PUBLIC_API_MODE=mock

# Base URL of the NestJS backend. Only used when EXPO_PUBLIC_API_MODE=live.
# Staging: https://sukun-staging-staging.up.railway.app
EXPO_PUBLIC_API_BASE_URL=

# Analytics. Each environment has its own Mixpanel project and its own Clarity project; the
# per-build values live in eas.json's build profiles. Leave a value blank to turn that SDK off
# for local work: a missing id disables the SDK rather than falling back to another project.
# The Mixpanel project must be in the EU region, since the app posts to api-eu.mixpanel.com.
# Tags every event and replay session so the two datasets stay separable: staging | production.
EXPO_PUBLIC_ANALYTICS_ENV=staging
EXPO_PUBLIC_MIXPANEL_TOKEN=
EXPO_PUBLIC_CLARITY_PROJECT_ID=

# The guest path: the "Skip login" link on Welcome, the exit out of the selfie step, and the
# signed-out states on the Tickets and Profile tabs. App Store guideline 5.1.1(v) requires
# that features which are not account based work without registration, so this ships enabled
# in every build profile in eas.json. Unlike the analytics ids, an unset value means ENABLED:
# a profile that forgets it must not ship the configuration Apple rejected. Only the literal
# "false" turns the guest path off.
EXPO_PUBLIC_ALLOW_GUEST_BROWSING=true
