{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "mock",
        "EXPO_PUBLIC_ANALYTICS_ENV": "staging",
        "EXPO_PUBLIC_MIXPANEL_TOKEN": "71571cdae3de3136c0c4318927206845",
        "EXPO_PUBLIC_CLARITY_PROJECT_ID": "y6tknxh6u4",
        "EXPO_PUBLIC_ALLOW_GUEST_BROWSING": "true"
      },
      "android": {
        "env": {
          "EXPO_PUBLIC_ALLOW_GUEST_BROWSING": "false"
        }
      }
    },
    "staging": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "distribution": "internal",
        "env": {
          "EXPO_PUBLIC_ALLOW_GUEST_BROWSING": "false"
        }
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "live",
        "EXPO_PUBLIC_API_BASE_URL": "https://staging-api.sukunwellness.co",
        "EXPO_PUBLIC_ANALYTICS_ENV": "staging",
        "EXPO_PUBLIC_MIXPANEL_TOKEN": "71571cdae3de3136c0c4318927206845",
        "EXPO_PUBLIC_CLARITY_PROJECT_ID": "y6tknxh6u4",
        "EXPO_PUBLIC_ALLOW_GUEST_BROWSING": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_MODE": "live",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.sukunwellness.co",
        "EXPO_PUBLIC_ANALYTICS_ENV": "production",
        "EXPO_PUBLIC_MIXPANEL_TOKEN": "a13190d158d029d86139e40c769a0ab9",
        "EXPO_PUBLIC_CLARITY_PROJECT_ID": "ybx65otc8o",
        "EXPO_PUBLIC_META_APP_ID": "1119615327425047",
        "EXPO_PUBLIC_META_CLIENT_TOKEN": "c2be3edef8a951fa020f6d1326a5f391",
        "EXPO_PUBLIC_ALLOW_GUEST_BROWSING": "true"
      },
      "android": {
        "env": {
          "EXPO_PUBLIC_ALLOW_GUEST_BROWSING": "false"
        }
      }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "6804203454"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6804203454"
      },
      "android": {
        "serviceAccountKeyPath": "../secrets/sukun-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
