  "info": {
    "contact": {},
    "description": "Sukun events platform backend - Public API",
    "title": "Sukun Backend API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/public/events": {
      "get": {
        "description": "Returns a cursor-paginated list of publicly visible events. Filters apply before ordering. Same-field values use OR; different fields use AND. Date boundaries are interpreted in Africa/Cairo (inclusive from, exclusive next-day to). No authentication is required.",
        "operationId": "PublicEventsController_list_v1",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "example": "eyJ2IjoxfQ.signature",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "example": 20,
              "maximum": 50,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "description": "Repeated for OR semantics. Allowed: published, on_sale, sold_out, sales_closed, live, completed, cancelled",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Repeated for OR/overlap semantics. Max 20 unique values, 80 chars each.",
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "When true, filters to upcoming events (not started yet, expected to become live).",
            "in": "query",
            "name": "upcoming",
            "required": false,
            "schema": {
              "example": true,
              "type": "boolean"
            }
          },
          {
            "description": "Filter by earliest startsAt (Cairo date, inclusive).",
            "in": "query",
            "name": "startsFrom",
            "required": false,
            "schema": {
              "example": "2026-10-01",
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "Filter by latest startsAt (Cairo date, exclusive next day).",
            "in": "query",
            "name": "startsTo",
            "required": false,
            "schema": {
              "example": "2026-10-31",
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "Filter by earliest endsAt (Cairo date, inclusive).",
            "in": "query",
            "name": "endsFrom",
            "required": false,
            "schema": {
              "example": "2026-10-01",
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "Filter by latest endsAt (Cairo date, exclusive next day).",
            "in": "query",
            "name": "endsTo",
            "required": false,
            "schema": {
              "example": "2026-10-31",
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "Filter by earliest salesCloseAt (Cairo date, inclusive).",
            "in": "query",
            "name": "salesCloseFrom",
            "required": false,
            "schema": {
              "example": "2026-10-01",
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "Filter by latest salesCloseAt (Cairo date, exclusive next day).",
            "in": "query",
            "name": "salesCloseTo",
            "required": false,
            "schema": {
              "example": "2026-10-31",
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "enum": ["ar", "en"],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/PublicEventListItemResponseDto"
                      },
                      "type": "array"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/CursorPageMetaDto"
                    }
                  },
                  "required": ["data", "meta"],
                  "type": "object"
                }
              }
            },
            "description": "Paginated list of public events."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Invalid event filters or cursor query."
          }
        },
        "summary": "List public events",
        "tags": ["Public Events"]
      }
    },
    "/api/v1/public/events/{identifier}": {
      "get": {
        "description": "Returns full event detail by UUID or slug. Missing, draft, and soft-deleted events return 404 EVENT_NOT_FOUND. Tier availability is computed live and not cached. No authentication is required.",
        "operationId": "PublicEventsController_detail_v1",
        "parameters": [
          {
            "description": "Event UUID or slug.",
            "in": "path",
            "name": "identifier",
            "required": true,
            "schema": {
              "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[a-z0-9]+(?:-[a-z0-9]+)*)$",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "enum": ["ar", "en"],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicEventDetailResponseDto"
                }
              }
            },
            "description": "Full event detail."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Invalid event identifier."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "EVENT_NOT_FOUND"
          }
        },
        "summary": "Get public event detail",
        "tags": ["Public Events"]
      }
    },
    "/api/v1/public/events/{identifier}/meta": {
      "get": {
        "description": "Returns minimal metadata for Open Graph and marketing-page rendering. Does not load tier availability or media arrays. No authentication is required.",
        "operationId": "PublicEventsController_meta_v1",
        "parameters": [
          {
            "description": "Event UUID or slug.",
            "in": "path",
            "name": "identifier",
            "required": true,
            "schema": {
              "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[a-z0-9]+(?:-[a-z0-9]+)*)$",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "enum": ["ar", "en"],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicEventMetaResponseDto"
                }
              }
            },
            "description": "Event metadata."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Invalid event identifier."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "EVENT_NOT_FOUND"
          }
        },
        "summary": "Get public event metadata",
        "tags": ["Public Events"]
      }
    }
  },
  "servers": [],
  "tags": [
    {
      "description": "",
      "name": "Public Events"
    }
  ]
}
